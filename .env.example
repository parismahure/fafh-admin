# Copy to .env.local for local development. Create React App inlines REACT_APP_*
# variables at build time, so these are build-time settings: a deployment needs
# them set when `npm run build` runs.

# Base URL of the FAFH API, with no trailing slash.
#
# Leave empty for local development: requests then go to the same origin and
# src/setupProxy.js forwards them to the API on port 5050.
#
# If unset entirely, src/config.js falls back to the deployed backend.
REACT_APP_API_BASE_URL=
